if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
}

const auth = firebase.auth();
const db = firebase.firestore();

// Use the EXACT ID from your HTML form
const signupForm = document.getElementById("signupForm"); 

if (signupForm) {
    signupForm.addEventListener("submit", async (e) => {
        e.preventDefault(); 
        console.log("Form submission intercepted!");

        const user = auth.currentUser;
        if (!user) {
            alert("No user found. Please login again.");
            window.location.href = "login.html";
            return;
        }

        const patientData = {
            uid: user.uid,
            fullName: user.displayName,
            email: user.email,
            role: document.getElementById("role").value,
            phone: document.getElementById("phone").value,
            idNumber: document.getElementById("idNumber").value || "N/A",
            createdAt: firebase.firestore.FieldValue.serverTimestamp()
        };

        try {
            await db.collection("patients").doc(user.uid).set(patientData);
            console.log("Patient created!");
            window.location.href = "dashboard.html";
        } catch (error) {
            console.error("Firestore Error:", error);
            alert("Permission Error: Check your Firebase Rules!");
        }
    });
} else {
    console.error("Could not find element with ID 'signupForm'");
}