rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- Helper Functions --
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isSupportTeam() {
      return signedIn() && request.auth.token.email in [
        'mahlatseclayton1@gmail.com',
        '2821750@students.wits.ac.za',
        '2829538@students.wits.ac.za',
        '2841214@students.wits.ca.za',
        '2913455@students.wits.ac.za',
        'gontsemaledu99@gmail.com',
        'Nnaki128@gmail.com'
      ];
    }

    // -- Collection Rules --

    // Patients can only read and update their own profiles
    match /patients/{uid} {
      allow read, write: if isOwner(uid);
    }
    
    // Admins can read their own profiles (Writes handled by server)
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; 
    }
    
    // Staff can read their own profiles (Writes handled by server)
    match /staff/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    
    // Legacy/Centralized users collection
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Clinics are publicly searchable; only the owning admin can update profile fields
    match /clinics/{clinicId} {
      allow read: if true;
      // Server can write/delete freely (handled via Admin SDK)
      allow create, delete: if false;
      // Authenticated admin can update their own clinic's profile metadata, excluding read-only Google Maps/administrative fields
      allow update: if signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.clinicId == clinicId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['province', 'district', 'region', 'address', 'clinicName', 'placeId', 'adminCode', 'adminUid', 'isActive']));
    }

    // Appointments are private to the patient, but readable by clinic staff
    match /appointments/{appointmentId} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid))
      );
      allow create: if signedIn() && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.patientId == request.auth.uid;
    }

    // Admin Invitations - Only support team can create, read, and manage
    match /adminInvitations/{invitationId} {
      allow read, create, update, delete: if isSupportTeam();
    }
    
    // Default Deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
